# ============================================
# InitHub Automation Configuration
# ============================================

# Application Configuration
INITHUB_URL=http://localhost:5173/

# Browser Configuration
HEADLESS_MODE=false

# Login Credentials
DEFAULT_EMAIL=admin@inithub.com
DEFAULT_PASSWORD=umaSenhaPadrao123

# ============================================
# LLM Configuration (Optional)
# ============================================
# Se não configurado, a automação usará respostas pré-definidas (fallback mode)

OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
OPENROUTER_MODEL_NAME=gpt-4o-mini
AGENT_MODEL_TEMPERATURE=0.7

# ============================================
# Automation Behavior
# ============================================

# Maximum number of interactions before stopping
MAX_INTERACTIONS=10

# Timeout in seconds for waiting agent responses
DEFAULT_TIMEOUT=15

# Delay in seconds between user actions (humanized behavior)
MESSAGE_DELAY=1.0

# Wait time in seconds before reading agent response
RESPONSE_WAIT_TIME=20.0
